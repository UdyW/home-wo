# Copy to .env.local for local development. Vercel sets these through the Supabase integration.
# Both are public values (they end up in the app); never put secret keys here.
NEXT_PUBLIC_SUPABASE_HJLSUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_HJLSUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
